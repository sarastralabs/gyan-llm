# Copy to .env. Never commit .env.

# REQUIRED. Protects the /admin API (create keys, usage). At least 24 characters:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# REQUIRED. Secret for the SearXNG search container:
#   python -c "import secrets; print(secrets.token_hex(32))"
SEARXNG_SECRET=

# Model used when a request does not name one.
DEFAULT_MODEL=qwen2.5:3b
# Comma-separated models clients may use. Empty = every installed model.
ALLOWED_MODELS=

# Capacity. A 2-core machine serves one generation at a time; others wait in line.
MAX_CONCURRENT=1
MAX_QUEUE=8
QUEUE_TIMEOUT_S=120
MAX_TOKENS_CAP=1024

# Images: a picture is turned into text, then the chat model answers. Tesseract reads documents
# and screenshots in about a second (English, Hindi and Kannada are installed; use e.g.
# TESSERACT_LANGS=eng+kan for mixed text). When Tesseract is unsure or finds no text (a photo),
# VISION_MODEL describes the picture; that is slow (minutes) on a 2-core server.
# Each image costs IMAGE_COST units of the key's limits.
TESSERACT_LANGS=eng
VISION_MODEL=qwen2.5vl:3b
MAX_IMAGES=3
MAX_IMAGE_BYTES=4000000
IMAGE_COST=3

# Research (web search + reading pages). Name clients use as the `model`:
RESEARCH_MODEL_NAME=gyan-research
# Pages read per answer, and the context budget (characters) given to the model.
RESEARCH_MAX_SOURCES=3
RESEARCH_CHARS_TOTAL=6000
# One research request uses this many units of a key's per-minute and daily limits.
RESEARCH_COST=3
# Research pipelines (search + page fetching) running at once.
RESEARCH_CONCURRENCY=2

# Default limits for new API keys (override per key).
DEFAULT_RPM=20
DEFAULT_DAILY=500

# true ONLY behind nginx, so the real client IP is used for the failed-login guard.
TRUST_PROXY=false
# Browser origins allowed to call the API, comma-separated. Empty = none.
CORS_ORIGINS=

# ---------------------------------------------------------------- Chat UI (docker compose --profile ui)

# The gateway API key the UI uses. Create it once the gateway is running (the key is shown once):
#   docker compose exec gateway gyan-gateway create-key --name gyan-ui --rpm 300 --daily 5000
GYAN_API_KEY=

# Secrets for UI logins and stored credentials. `python scripts/init_env.py` fills these in.
JWT_SECRET=
JWT_REFRESH_SECRET=
CREDS_KEY=
CREDS_IV=

# Public address of the UI, no trailing slash. Use your https address in production.
DOMAIN_CLIENT=http://localhost:3080
# true ONLY while creating the first (admin) account, then false and `docker compose --profile ui up -d`.
ALLOW_REGISTRATION=false

# Host port for the gateway, if 8000 is already used by another program on this machine.
# GATEWAY_PORT=8000

# Only if Ollama runs outside compose (for example behind an SSH tunnel on a PC):
# OLLAMA_URL=http://host.docker.internal:11435
