# Public front door for Gyan. Installed by scripts/setup-nginx.sh, which fills in __HOST__.
#
#   https://HOST/        the chat UI (LibreChat)
#   https://HOST/v1/     the OpenAI-compatible API for other platforms (needs an API key)
#
# Never routed from outside: the gateway's /admin and /readyz, and Redis, Ollama, SearXNG, MongoDB.
# certbot (--nginx) adds the HTTPS server block and the http -> https redirect to this file.

limit_req_zone $binary_remote_addr zone=gyan_login:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=gyan_api:10m rate=120r/m;
limit_req_zone $binary_remote_addr zone=gyan_ui:10m rate=600r/m;
limit_conn_zone $binary_remote_addr zone=gyan_conn:10m;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream gyan_ui  { server 127.0.0.1:3080; keepalive 16; }
upstream gyan_api { server 127.0.0.1:8000; keepalive 8; }

server {
    listen 80;
    listen [::]:80;
    server_name __HOST__;
    server_tokens off;

    client_max_body_size 12m;  # photos and scans
    limit_conn gyan_conn 40;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "SAMEORIGIN" always;

    # Internal endpoints: not reachable from the internet.
    location ^~ /admin { return 404; }
    location = /readyz { return 404; }
    location = /metrics { return 404; }

    # OpenAI-compatible API (chat, models, research). Streaming answers: no buffering.
    location /v1/ {
        limit_req zone=gyan_api burst=30 nodelay;
        proxy_pass http://gyan_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Sign-in and sign-up: a tight limit against password guessing.
    location ~ ^/api/auth/(login|register)$ {
        limit_req zone=gyan_login burst=5 nodelay;
        proxy_pass http://gyan_ui;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # The chat UI. Answers stream to the browser, so buffering is off and timeouts are long.
    location / {
        limit_req zone=gyan_ui burst=100 nodelay;
        proxy_pass http://gyan_ui;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
